<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Progress indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_waiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="@color/color_fab_active" />

        <!-- Subscription group tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:padding="@dimen/padding_spacing_dp8"
            app:tabBackground="@drawable/bg_tab_item_focus"
            app:tabIndicatorFullWidth="false"
            app:tabMode="scrollable"
            app:tabRippleColor="@color/color_fab_active"
            app:tabTextAppearance="@style/TabLayoutTextStyle" />

        <!-- Server list: weight=1, fills remaining space -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nextFocusDown="@+id/layout_test"
            android:nextFocusRight="@+id/fab"
            android:nextFocusUp="@+id/tab_group"
            android:scrollbars="vertical" />

        <!-- Divider above the bottom bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color_light" />

        <!-- Bottom bar: test state (left) + FAB (right), always visible -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/view_height_dp64"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Test-state area, takes all width except FAB -->
            <LinearLayout
                android:id="@+id/layout_test"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_focus"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusLeft="@+id/recycler_view"
                android:nextFocusRight="@+id/fab"
                android:nextFocusUp="@+id/recycler_view"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_test_state"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="start|center"
                    android:maxLines="2"
                    android:minLines="1"
                    android:paddingStart="@dimen/padding_spacing_dp16"
                    android:text="@string/connection_test_pending"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small" />

            </LinearLayout>

            <!-- FAB embedded in the bottom bar — always reachable via D-pad RIGHT from any row -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/padding_spacing_dp8"
                android:clickable="true"
                android:contentDescription="@string/tasker_start_service"
                android:focusable="true"
                android:nextFocusLeft="@+id/layout_test"
                android:nextFocusUp="@+id/recycler_view"
                android:src="@drawable/ic_play_24dp" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:itemBackground="@drawable/bg_nav_item_focus"
        app:itemIconTint="@color/color_fab_active"
        app:itemTextColor="@color/colorAccent"
        app:menu="@menu/menu_drawer">

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
